{
  "_group": "view",
  "_name": "DISPLAY",
  "uri": "view/DISPLAY",
  "methods": "POST",
  "schema": {
    "DISPLAY": {
      "type": "object",
      "description": "Display Option (DISPLAY). Controls which model entities, boundaries, loads and view decorations are drawn in the active model window; every group is optional and each boolean toggles the visibility of one item.",
      "properties": {
        "Argument": {
          "type": "object",
          "description": "Display option request. All groups are optional; only the groups/fields you include are applied.",
          "properties": {
            "NODE": {
              "type": "object",
              "description": "Node display toggles.",
              "properties": {
                "NODE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show nodes."
                },
                "NODE_NUMBER": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show node numbers."
                },
                "STORY_NAME": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show story name."
                },
                "NODE_LOCAL_AXIS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show node local axis."
                }
              }
            },
            "ELEMENT": {
              "type": "object",
              "description": "Element display toggles.",
              "properties": {
                "ELEM_NUMBER": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show element numbers."
                },
                "WALL_ID": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show wall ID."
                },
                "GAP": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show gap elements."
                },
                "HOOK": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show hook elements."
                },
                "CABLE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show cable elements."
                },
                "LOCAL_AXIS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show element local axis."
                }
              }
            },
            "PROPERTY": {
              "type": "object",
              "description": "Property display toggles.",
              "properties": {
                "PROPERTY_NUMBER": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show property numbers."
                },
                "PROPERTY_NAME": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show property names."
                },
                "SECTION_SHAPE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show section shape."
                },
                "INELASTIC_HINGE_SYMBOL": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show inelastic hinge symbol."
                },
                "INELASTIC_HINGE_NAME": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show inelastic hinge name."
                }
              }
            },
            "BOUNDARY": {
              "type": "object",
              "description": "Boundary condition display toggles.",
              "properties": {
                "GROUP_SELECTION": {
                  "type": "array",
                  "description": "Boundary group selection list (names of boundary groups to display).",
                  "items": {
                    "type": "string"
                  }
                },
                "SUPPORT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show supports."
                },
                "SUPPORT_BY_DIRECTION": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show support by direction."
                },
                "POINT_SPRING_SUPPORT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show point spring support."
                },
                "POINT_SPRING_SUPPORT_COMP_TENS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show point spring support (Comp/Tens)."
                },
                "POINT_SPRING_SUPPORT_MULTI_LINEAR": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show point spring support (Multi-Linear)."
                },
                "POINT_SPRING_SUPPORT_BY_DIRECTION": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show point spring support by direction."
                },
                "POINT_SPRING_SUPPORT_BY_DIRECTION_COMP_TENS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show point spring support by direction (Comp/Tens)."
                },
                "POINT_SPRING_SUPPORT_BY_DIRECTION_MULTI_LINEAR": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show point spring support by direction (Multi-Linear)."
                },
                "SURFACE_SPRING_SUPPORT_TYPE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show surface spring support type."
                },
                "SURFACE_SPRING_SUPPORT_LINEAR": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show surface spring support (Linear)."
                },
                "SURFACE_SPRING_SUPPORT_COMP_TENS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show surface spring support (Comp/Tens)."
                },
                "GENERAL_SPRING_SUPPORT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show general spring support."
                },
                "ELASTIC_LINK": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show elastic link."
                },
                "ELASTIC_LINK_LOCAL_AXIS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show elastic link local axis."
                },
                "ELASTIC_LINK_TYPE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show elastic link type."
                },
                "ELASTIC_LINK_NUMBER": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show elastic link number."
                },
                "GENERAL_LINK": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show general link."
                },
                "GENERAL_LINK_NUMBER": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show general link number."
                },
                "GENERAL_LINK_LOCAL_AXIS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show general link local axis."
                },
                "GENERAL_LINK_TYPE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show general link type."
                },
                "CHANGE_GENERAL_LINK_PROPERTIES": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show change general link properties."
                },
                "BEAM_END_RELEASE_SYMBOL": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show beam end release symbol."
                },
                "BEAM_END_RELEASE_DIGIT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show beam end release digit."
                },
                "BEAM_END_OFFSET_SYMBOL": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show beam end offset symbol."
                },
                "BEAM_END_OFFSET_DIGIT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show beam end offset digit."
                },
                "PLATE_END_RELEASE_SYMBOL": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show plate end release symbol."
                },
                "PLATE_END_RELEASE_DIGIT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show plate end release digit."
                },
                "RIGID_LINK": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show rigid link."
                },
                "LINEAR_CONSTRAINTS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show linear constraints."
