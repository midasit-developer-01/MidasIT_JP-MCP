                  "description": "Show story diaphragm."
                },
                "DIAPHRAGM_DISCONNECT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show diaphragm disconnect."
                }
              }
            },
            "MISC": {
              "type": "object",
              "description": "Miscellaneous display toggles.",
              "properties": {
                "NODAL_MASS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show nodal mass."
                },
                "LOAD_TO_MASS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show load to mass."
                },
                "TENDON_PROFILE_NAMES": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show tendon profile names."
                },
                "TENDON_PROFILE_POINT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show tendon profile point."
                },
                "SETTLEMENT_GROUP": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show settlement group."
                },
                "SETTLEMENT_GROUP_VALUE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show settlement group value."
                },
                "HEAT_OF_HYDRATION_VALUE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show heat of hydration value."
                },
                "HEAT_OF_HYDRATION_FUNC_NAME": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show heat of hydration function name."
                },
                "HEAT_OF_HYDRATION_ELEMENT_CONVECTION_BOUNDARY": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show heat of hydration element convection boundary."
                },
                "HEAT_OF_HYDRATION_PRESCRIBED_TEMPERATURE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show heat of hydration prescribed temperature."
                },
                "HEAT_OF_HYDRATION_HEAT_SOURCE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show heat of hydration heat source."
                },
                "HEAT_OF_HYDRATION_PIPE_COOLING_ELEMENT": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show heat of hydration pipe cooling element."
                },
                "GRID_MODEL_LOAD_LINE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show grid model load line."
                }
              }
            },
            "LOAD": {
              "type": "object",
              "description": "Load display toggles and load-display options.",
              "properties": {
                "CASE_SELECTION": {
                  "type": "object",
                  "description": "Load case selection options.",
                  "properties": {
                    "TYPE": {
                      "type": "string",
                      "description": "Load case type."
                    },
                    "NAME": {
                      "type": "string",
                      "description": "Load case name."
                    }
                  },
                  "required": [
                    "TYPE",
                    "NAME"
                  ]
                },
                "GROUP_SELECTION": {
                  "type": "array",
                  "description": "Load group selection list (names of load groups to display).",
                  "items": {
                    "type": "string"
                  }
                },
                "LOAD_VALUE": {
                  "type": "object",
                  "description": "Load value display options (numeric format and decimal places).",
                  "properties": {
                    "FORMAT": {
                      "type": "string",
                      "enum": [
                        "Default",
                        "Fixed",
                        "Scientific"
                      ],
                      "description": "Number format of displayed load values (case-insensitive)."
                    },
                    "PLACE": {
                      "type": "integer",
                      "description": "Number of decimal places for displayed load values."
                    }
                  },
                  "required": [
                    "FORMAT",
                    "PLACE"
                  ]
                },
                "NODAL_BODY_FORCE": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show nodal body force."
                },
                "NODAL_LOAD": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show nodal load."
                },
                "SPECIFIED_DISPLACEMENT": {
