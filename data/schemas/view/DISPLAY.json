                  "default": false,
                  "description": "Show finishing material load."
                },
                "PRESSURE_LOAD": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show pressure load."
                },
                "AREA_PRESSURE_LOADS": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show area pressure loads."
                },
                "PLANE_LOAD": {
                  "type": "boolean",
                  "default": false,
                  "description": "Show plane load."
                },
                "PLANE_LOAD_NAME": {
                  "type": "boolean",
                  "default": false,
