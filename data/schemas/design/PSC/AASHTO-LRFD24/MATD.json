{
  "_group": "design",
  "_name": "MATD",
  "uri": "design/PSC/AASHTO-LRFD24/MATD",
  "methods": "GET, PUT, DELETE",
  "schema": {
    "MATD": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "PSC Design Material (MATD_PSC_ITEM). Defines girder (and optionally slab) concrete and rebar design material properties for a single material key; fields are driven by each property's design CODE (None = custom input, otherwise grade looked up from the code DB) and by whether the section is a PSC composite section with slab properties.",
      "additionalProperties": false,
      "required": [
        "GIRDER_MATL_PROP",
        "GIRDER_REBAR_PROP"
      ],
      "properties": {
        "GIRDER_MATL_PROP": {
          "description": "Girder concrete material property.",
          "$ref": "#/definitions/MATD_PSC_MATL_PROP"
        },
        "GIRDER_REBAR_PROP": {
          "description": "Girder rebar property.",
          "$ref": "#/definitions/MATD_PSC_REBAR_PROP"
        },
        "SLAB_PROP": {
          "type": "boolean",
          "default": false,
          "description": "Whether slab material/rebar properties are applied. Slab properties are only used when the section is a PSC composite section and this is true; then SLAB_MATL_PROP and SLAB_REBAR_PROP become required."
        },
        "SLAB_MATL_PROP": {
          "description": "[SLAB_PROP=true on a PSC composite section] Slab concrete material property (keeps existing if omitted).",
          "$ref": "#/definitions/MATD_PSC_MATL_PROP"
        },
        "SLAB_REBAR_PROP": {
          "description": "[SLAB_PROP=true on a PSC composite section] Slab rebar property (keeps existing if omitted).",
          "$ref": "#/definitions/MATD_PSC_REBAR_PROP"
        }
      },
      "definitions": {
        "MATD_PSC_CODE": {
          "type": "string",
          "description": "Concrete/rebar design code (case-insensitive). 'None' = custom material.",
          "enum": [
            "None",
            "ASTM19(RC)",
            "ASTM(RC)",
            "U.S.C(US)(RC)",
            "U.S.C(SI)(RC)",
            "NMX2023(RC)",
            "NMX2023(MKS)(RC)",
            "NMX NTC-2017(RC)",
            "CSA(RC)",
            "BS(RC)",
            "EN04(RC)",
            "EN(RC)",
            "NTC08(RC)",
            "NTC12(RC)",
            "NTC18(RC)",
            "UNI(RC)",
            "SS(RC)",
            "GOST-SP(RC)",
            "GOST-SNIP(RC)",
            "JIS(RC)",
            "JIS-Civil(RC)",
            "JTJ023-85(RC)",
            "Q/CR 9300-18(RC)",
            "GB 50917-13(RC)",
            "GB/T10(RC)",
            "GB(RC)",
            "GB-Civil(RC)",
            "TB10092-17(RC)",
            "JTG3362-18(RC)",
            "JTG04(RC)",
            "TB05(RC)",
            "KS19(RC)",
            "KS01(RC)",
            "KS(RC)",
            "KSCE-LSD15(RC)",
            "KS01-Civil(RC)",
            "KS-Civil(RC)",
            "PNS49(RC)",
            "SNI(RC)",
            "TIS(RC)",
            "TIS(MKS)(RC)",
            "IRC(RC)",
            "IRS(RC)",
            "IS(RC)",
            "CNS560-18(RC)",
            "CNS560(RC)",
            "CNS(RC)",
            "AS17(RC)",
            "TMH7(RC)",
            "SP63.2018(RC)",
            "TS(RC)",
            "NBR 6118(RC)"
          ]
        },
        "MATD_PSC_MATL_PROP": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CODE"
          ],
          "properties": {
            "CODE": {
              "description": "Concrete design code. 'None' = custom material.",
              "$ref": "#/definitions/MATD_PSC_CODE"
            },
            "LIGHT_WEIGHT_FACTOR": {
              "type": "boolean",
              "default": false,
              "description": "Light weight concrete factor flag. When true, FACTOR_VALUE is required."
            },
            "NAME": {
              "type": "string",
              "description": "[CODE=None] Custom material name (required when CODE=None)."
            },
            "COMP_STRENGTH": {
              "type": "number",
              "description": "[CODE=None] Specified compressive strength f'c (kN/m2), required when CODE=None. When CODE!=None the value is auto-looked up from the code DB by GRADE and any input here is ignored."
            },
            "GRADE": {
              "type": "string",
              "description": "[CODE!=None] Concrete grade (required when CODE!=None); must be a valid grade for the selected concrete CODE."
            },
            "FACTOR_VALUE": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1.0,
              "description": "[LIGHT_WEIGHT_FACTOR=true] Light weight factor value (0.75~1.0), required when LIGHT_WEIGHT_FACTOR is true."
            }
          }
        },
        "MATD_PSC_REBAR_PROP": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CODE"
          ],
          "properties": {
            "CODE": {
              "description": "Rebar design code. 'None' = custom rebar.",
              "$ref": "#/definitions/MATD_PSC_CODE"
            },
            "GRADE_MAIN_REBAR": {
              "type": "string",
              "description": "[CODE!=None] Main rebar grade (required when CODE!=None); must be a valid grade for the selected rebar CODE."
            },
            "GRADE_SUB_REBAR": {
              "type": "string",
              "description": "[CODE!=None] Sub-rebar grade (required when CODE!=None); must be a valid grade for the selected rebar CODE."
            },
            "NAME_MAIN_REBAR": {
              "type": "string",
              "description": "[CODE=None] Custom main rebar name (required when CODE=None)."
            },
            "NAME_SUB_REBAR": {
              "type": "string",
              "description": "[CODE=None] Custom sub-rebar name (required when CODE=None)."
            },
            "Fy": {
              "type": "number",
              "description": "[CODE=None] Main rebar yield strength Fy (required when CODE=None)."
            },
            "Fys": {
              "type": "number",
              "description": "[CODE=None] Sub-rebar yield strength Fys (required when CODE=None)."
            }
          }
        }
      }
    }
  },
  "example": {
    "Assign": {
      "1": {
        "GIRDER_MATL_PROP": {
          "CODE": "None",
          "NAME": "C40 Custom",
          "COMP_STRENGTH": 40000.0,
          "LIGHT_WEIGHT_FACTOR": true,
          "FACTOR_VALUE": 0.85
        },
        "GIRDER_REBAR_PROP": {
          "CODE": "None",
          "NAME_MAIN_REBAR": "Custom Main",
          "NAME_SUB_REBAR": "Custom Sub",
          "Fy": 400000.0,
          "Fys": 400000.0
        },
        "SLAB_PROP": true,
        "SLAB_MATL_PROP": {
          "CODE": "ASTM19(RC)",
          "GRADE": "Grade C4000",
          "LIGHT_WEIGHT_FACTOR": false
        },
        "SLAB_REBAR_PROP": {
          "CODE": "ASTM19(RC)",
          "GRADE_MAIN_REBAR": "Grade 60",
          "GRADE_SUB_REBAR": "Grade 60"
        }
      }
    }
  }
}
