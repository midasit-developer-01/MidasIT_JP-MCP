{
  "_group": "design",
  "_name": "CC-REPORT",
  "uri": "design/RC/KDS-41-20-2022/CC-REPORT",
  "methods": "POST",
  "schema": {
    "CC-REPORT": {
      "type": "object",
      "description": "RC Column Check Report (CC-REPORT). Generates a design report file for KDS-41-20-2022 RC column checking; fields are driven by the REPORT_REQUEST DTO and control report type, mode, target selection and output location.",
      "properties": {
        "Argument": {
          "type": "object",
          "description": "Report generation request (REPORT_REQUEST).",
          "properties": {
            "REPORT_TYPE": {
              "type": "string",
              "enum": ["MEMB", "PROP"],
              "description": "Report Type: MEMB (per-member) or PROP (per-property). Case-insensitive."
            },
            "EXPORT_PATH": {
              "type": "string",
              "description": "Export Path (e.g. C:\\MIDAS\\Report\\)."
            },
            "OUTPUT_NAME": {
              "type": "string",
              "description": "Output File Name."
            },
            "CURRENT_MODE": {
              "type": "string",
              "enum": ["Graphic", "Detail", "Summary", "PMCurve"],
              "description": "Report Mode. Case-insensitive."
            },
            "CURRENT_MODE_MEMB": {
              "type": "string",
              "enum": ["Graphic", "Detail", "Summary", "PMCurve"],
              "description": "Report Mode (MEMB). Case-insensitive."
            },
            "CURRENT_MODE_PROP": {
              "type": "string",
              "enum": ["Graphic", "Detail", "Summary", "PMCurve"],
              "description": "Report Mode (PROP). Case-insensitive."
            },
            "ELEMS": {
              "type": "object",
              "description": "Element Numbers (DESIGN_ANAL_ELEM_SELECTION).",
              "properties": {
                "KEYS": {
                  "type": "array",
                  "items": { "type": "integer" },
                  "description": "Specify Each ID - Element No."
                },
                "TO": {
                  "type": "string",
                  "description": "Specify ID Range - Element Range (e.g. 1-10)."
                },
                "STRUCTURE_GROUP_NAME": {
                  "type": "string",
                  "description": "Structure Group Name."
                }
              }
            },
            "SECTIONS": {
              "type": "array",
              "items": { "type": "integer" },
              "description": "Section Numbers."
            },
            "DETAIL_POSITIONS": {
              "type": "object",
              "description": "Detail Print Positions (for RC Beam Design MEMB mode) (CODE_REPORT_DETAIL_POSITIONS).",
              "properties": {
                "END_I": {
                  "type": "boolean",
                  "default": true,
                  "description": "Include End I position."
                },
                "MID": {
                  "type": "boolean",
                  "default": false,
                  "description": "Include Mid position."
                },
                "END_J": {
                  "type": "boolean",
                  "default": false,
                  "description": "Include End J position."
                }
              }
            }
          },
          "required": ["REPORT_TYPE", "EXPORT_PATH", "OUTPUT_NAME"]
        }
      }
    }
  },
  "example": {
    "Argument": {
      "REPORT_TYPE": "MEMB",
      "EXPORT_PATH": "C:\\MIDAS\\Report\\",
      "OUTPUT_NAME": "RC_Column_Check",
      "CURRENT_MODE": "Detail",
      "ELEMS": {
        "KEYS": [1, 2, 3],
        "TO": "1-10"
      },
      "SECTIONS": [1, 2],
      "DETAIL_POSITIONS": {
        "END_I": true,
        "MID": false,
        "END_J": true
      }
    }
  }
}
