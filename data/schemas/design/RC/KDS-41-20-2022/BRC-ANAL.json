{
  "_group": "design",
  "_name": "BRC-ANAL",
  "uri": "design/RC/KDS-41-20-2022/BRC-ANAL",
  "methods": "POST",
  "schema": {
    "BRC-ANAL": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "RC Brace Design Analysis (BRC-ANAL). Fields are driven by the DESIGN_ANAL request DTO, whose PERFORM_TYPE selects whether design is performed for all elements, specific element numbers, or specific section numbers.",
      "properties": {
        "Argument": {
          "type": "object",
          "description": "Request body (DESIGN_ANAL). Controls the target selection for the RC brace design analysis.",
          "properties": {
            "PERFORM_TYPE": {
              "type": "string",
              "enum": ["ALL", "ELEMS", "SECTIONS"],
              "default": "ALL",
              "description": "Perform Target - All Elements: ALL / By Element No.: ELEMS / By Section No.: SECTIONS. Case-insensitive."
            },
            "ELEMS": {
              "type": "object",
              "description": "[PERFORM_TYPE=ELEMS] Element No. Object used to select elements.",
              "properties": {
                "KEYS": {
                  "type": "array",
                  "description": "Specify Each ID - Element No.",
                  "items": {
                    "type": "integer"
                  }
                },
                "TO": {
                  "type": "string",
                  "description": "Specify ID Range - Element Range (e.g. 1-10)."
                },
                "STRUCTURE_GROUP_NAME": {
                  "type": "string",
                  "description": "Structure Group Name."
                }
              }
            },
            "SECTIONS": {
              "type": "array",
              "description": "[PERFORM_TYPE=SECTIONS] Section No.",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "example": {
    "Argument": {
      "PERFORM_TYPE": "ELEMS",
      "ELEMS": {
        "KEYS": [1, 2, 3],
        "TO": "1-10",
        "STRUCTURE_GROUP_NAME": "Braces"
      },
      "SECTIONS": [1, 2]
    }
  }
}
