{
  "_group": "design",
  "_name": "DCRM-BEAM",
  "uri": "design/RC/KDS-41-20-2022/DCRM-BEAM",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "DCRM-BEAM": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Design Criteria for RC Beam Member (DCRMB). Defines the rebar sizes, stirrup arrangement and reinforced-concrete design options used when designing RC beams; fields are driven by the DTO_DCRMB rebar-name and splice enums.",
      "additionalProperties": false,
      "required": [
        "MAIN_REBAR",
        "STIRRUPS",
        "STIRRUP_ARRANGEMENT",
        "SIDE_BAR"
      ],
      "properties": {
        "MAIN_REBAR": {
          "type": "string",
          "description": "Main rebar size for the beam. Rebar-name enum (case-insensitive).",
          "enum": [
            "D4",
            "D5",
            "D6",
            "D7",
            "D8",
            "D10",
            "D13",
            "D16",
            "D19",
            "D22",
            "D25",
            "D29",
            "D32",
            "D35",
            "D38",
            "D41",
            "D43",
            "D51",
            "D57"
          ]
        },
        "STIRRUPS": {
          "type": "string",
          "description": "Stirrup (shear reinforcement) rebar size for the beam. Rebar-name enum (case-insensitive).",
          "enum": [
            "D4",
            "D5",
            "D6",
            "D7",
            "D8",
            "D10",
            "D13",
            "D16",
            "D19",
            "D22",
            "D25",
            "D29",
            "D32",
            "D35",
            "D38",
            "D41",
            "D43",
            "D51",
            "D57"
          ]
        },
        "STIRRUP_ARRANGEMENT": {
          "type": "integer",
          "description": "Stirrup leg count (number of sub-rebars) for the beam."
        },
        "SIDE_BAR": {
          "type": "string",
          "description": "Side bar rebar size for the beam. Rebar-name enum (case-insensitive).",
          "enum": [
            "D4",
            "D5",
            "D6",
            "D7",
            "D8",
            "D10",
            "D13",
            "D16",
            "D19",
            "D22",
            "D25",
            "D29",
            "D32",
            "D35",
            "D38",
            "D41",
            "D43",
            "D51",
            "D57"
          ]
        },
        "DT": {
          "type": "number",
          "description": "Top cover distance.",
          "default": 0.0
        },
        "DB": {
          "type": "number",
          "description": "Bottom cover distance.",
          "default": 0.0
        },
        "DOUBLY_REBAR": {
          "type": "boolean",
          "description": "Use doubly reinforced design.",
          "default": true
        },
        "DOUBLY_K": {
          "type": "number",
          "description": "Doubly reinforced k factor.",
          "default": 1.0
        },
        "SPACING_LIMIT": {
          "type": "boolean",
          "description": "Consider rebar spacing limit.",
          "default": true
        },
        "SPLICED_BARS": {
          "type": "string",
          "description": "Spliced bars option (case-insensitive).",
          "enum": [
            "None",
            "50%",
            "100%"
          ],
          "default": "50%"
        }
      }
    }
  },
  "example": {
    "Assign": {
      "1": {
        "MAIN_REBAR": "D22",
        "STIRRUPS": "D13",
        "STIRRUP_ARRANGEMENT": 2,
        "SIDE_BAR": "D10",
        "DT": 40.0,
        "DB": 40.0,
        "DOUBLY_REBAR": true,
        "DOUBLY_K": 1.0,
        "SPACING_LIMIT": true,
        "SPLICED_BARS": "50%"
      }
    }
  }
}
