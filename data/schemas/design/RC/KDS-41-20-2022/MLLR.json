{
  "_group": "design",
  "_name": "MLLR",
  "uri": "design/RC/KDS-41-20-2022/MLLR",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "MLLR": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Moment/Load Live-Load Reduction (MLLR). Fields define a reduction factor and which member force components it is applied to.",
      "properties": {
        "FACTOR": {
          "type": "number",
          "default": 1.0,
          "description": "Reduction factor applied to the selected components. Must be between 0.3 and 1.0.",
          "minimum": 0.3,
          "maximum": 1.0
        },
        "COMPONENTS": {
          "type": "object",
          "description": "Applied Components. Flags selecting which member force components the reduction factor is applied to. When omitted, all component flags default to false.",
          "properties": {
            "AXIAL": {
              "type": "boolean",
              "default": false,
              "description": "Apply reduction to axial force."
            },
            "MOMENT": {
              "type": "boolean",
              "default": false,
              "description": "Apply reduction to moments."
            },
            "SHEAR": {
              "type": "boolean",
              "default": false,
              "description": "Apply reduction to shear forces."
            }
          }
        }
      },
      "required": []
    }
  },
  "example": {
    "Assign": {
      "1": {
        "FACTOR": 0.8,
        "COMPONENTS": {
          "AXIAL": true,
          "MOMENT": true,
          "SHEAR": false
        }
      }
    }
  }
}
