{
  "_group": "design",
  "_name": "DFBA",
  "uri": "design/RC/KDS-41-20-2022/DFBA",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "DFBA": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Design Force Basis / Force Type (DFBA). The force basis used for RC design is driven by FORCE_TYPE.",
      "properties": {
        "FORCE_TYPE": {
          "type": "string",
          "description": "Force Type used as the basis for design forces (case-insensitive matching).",
          "enum": [
            "Subdivided Forces",
            "Member Forces"
          ]
        }
      },
      "required": [
        "FORCE_TYPE"
      ]
    }
  },
  "example": {
    "Assign": {
      "1": {
        "FORCE_TYPE": "Subdivided Forces"
      },
      "2": {
        "FORCE_TYPE": "Member Forces"
      }
    }
  }
}
