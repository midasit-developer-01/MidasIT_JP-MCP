{
  "_group": "design",
  "_name": "TABLE",
  "uri": "design/RC/KDS-41-20-2022/TABLE",
  "methods": "POST",
  "schema": {
    "TABLE": {
      "type": "object",
      "description": "Result Table (TABLE). Fields describe how to build/extract a result table (TABLE_TYPE to create, or TABLE_NAME to fetch), plus per-table selection filters (nodes/elements, load cases, stages, PSC design/rating filters) all supplied through the request DTO.",
      "properties": {
        "Argument": {
          "type": "object",
          "description": "Request DTO (DTO_TABLE_REQUEST). All fields optional; provide TABLE_TYPE to build a table or TABLE_NAME to fetch an existing one.",
          "properties": {
            "EXPORT_PATH": {
              "type": "string",
              "description": "Output Path. When assigned, the response table is also exported to this file path as JSON."
            },
            "TABLE_NAME": {
              "type": "string",
              "description": "Table Name. Used to fetch an existing table when TABLE_TYPE is not assigned.",
              "default": "empty"
            },
            "TABLE_TYPE": {
              "type": "string",
              "description": "Table type identifier, resolved server-side against the SAME master registry as post/TABLE (CDBGatewayTableTypes m_KeyValueMap, built from __caTableTypeMap in wg_tb/DBGatewayTableTypes.cpp) after normalization = uppercase + remove-all-spaces. This design endpoint uses the identical handler as post/TABLE, so the full Civil table-type vocabulary is valid here (analysis results, design-force, and PSC design/rating tables). An unknown key resolves to an empty/invalid table (silent) rather than a clean error, so it must match one of the enum keys exactly. Suffix convention: G=Global axis, L=Local axis (e.g. REACTIONG/REACTIONL, DISPLACEMENTG/DISPLACEMENTL; there is NO bare REACTION/DISPLACEMENTS). When omitted, TABLE_NAME is used to fetch a previously saved table.",
              "enum": [
                "SECTIONALL",
                "SECTIONDB/USER",
                "SECTIONVALUE",
                "SECTIONSRC",
                "SECTIONCOMBINED",
                "SECTIONTAPERED",
                "SECTIONPSC",
                "SECTIONCONSTRUCTION",
                "SECTIONCOMPOSITE",
                "SECTIONSTEELGIRDER",
                "MATERIAL",
                "FLOORLOADS",
                "NODALBODYFORCE",
                "SUPPORTS",
