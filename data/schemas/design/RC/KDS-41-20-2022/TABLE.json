            "UNIT": {
              "type": "object",
              "description": "Unit Define (DTO_BL_UNIT).",
              "properties": {
                "FORCE": {
                  "type": "string",
                  "description": "Force. Case-insensitive.",
                  "enum": [
                    "KGF",
                    "TONF",
                    "N",
                    "KN",
                    "LBF",
                    "KIPS"
                  ]
                },
                "DIST": {
                  "type": "string",
                  "description": "Distance. Case-insensitive.",
                  "enum": [
                    "MM",
                    "CM",
                    "M",
                    "IN",
                    "FT"
                  ]
                },
                "HEAT": {
                  "type": "string",
                  "description": "Heat. Case-insensitive.",
                  "enum": [
                    "CAL",
                    "KCAL",
                    "J",
                    "BTU",
                    "KJ"
                  ]
                },
                "TEMP": {
                  "type": "string",
                  "description": "Temper Unit. Case-insensitive.",
                  "enum": [
                    "C",
                    "F"
                  ]
                }
              }
            },
            "STYLES": {
              "type": "object",
              "description": "Styles Define (DTO_TABLE_STYLES).",
              "properties": {
                "FORMAT": {
                  "type": "string",
                  "description": "Style Format. Case-insensitive.",
                  "enum": [
                    "DEFAULT",
                    "SCIENTIFIC",
                    "FIXED",
                    "GENERAL"
                  ]
                },
                "PLACE": {
                  "type": "integer",
                  "description": "Style Place."
                }
              }
            },
            "REDUCTION_FACTOR": {
              "type": "object",
              "description": "Reduction Factor (Tendon Stress Limit Check) (DTO_TABLE_REDUCTION_FACTOR).",
              "properties": {
                "AT_ANCH": {
                  "type": "number",
                  "description": "Factor at anchorages immediately after anchor set.",
                  "default": 0.7
                },
                "AWAY_FROM_ANCH": {
                  "type": "number",
                  "description": "Factor away from anchorages, immediately after anchor set.",
                  "default": 0.74
                },
                "AT_SERVICE": {
                  "type": "number",
                  "description": "Factor at the service limit state, after losses.",
                  "default": 0.8
                }
              }
            },
            "AVERAGE_NODAL_RESULT": {
              "type": "boolean",
              "description": "Check Average Nodal Result."
            },
            "NODE_ELEMS": {
              "type": "object",
              "description": "Select Node or Elem List (DTO_TABLE_NODE_ELEMS).",
              "properties": {
                "KEYS": {
                  "type": "array",
                  "description": "Node or Elems.",
                  "items": {
                    "type": "integer"
                  }
                },
                "TO": {
                  "type": "string",
                  "description": "Method, TO (ex. 1to5)."
                },
                "STRUCTURE_GROUP_NAME": {
                  "type": "string",
                  "description": "Method, Structure Group Name."
                }
              }
            },
            "SECT_POSITION": {
              "type": "string",
              "description": "Select Section Position ex)1,3,5 / 1to8."
            },
            "OUTPUT_STEP": {
              "type": "string",
              "description": "Select Output Step ex)1,3,5 / 1to8."
            },
            "LOAD_CASE_NAMES": {
              "type": "array",
              "description": "Select Load Case Name List.",
              "items": {
                "type": "string"
              }
            },
            "PARTS": {
              "type": "array",
              "description": "Select Parts.",
              "items": {
                "type": "string"
              }
            },
            "NODE_FLAG": {
              "type": "object",
              "description": "Node Flag (DTO_TABLE_NODE_FLAG).",
              "properties": {
                "CENTER": {
                  "type": "boolean",
                  "description": "Check center."
                },
                "NODES": {
                  "type": "boolean",
                  "description": "Check Nodes."
                }
              }
            },
            "MODES": {
              "type": "array",
              "description": "Select Mode List.",
              "items": {
                "type": "string"
              }
            },
            "TH_LOAD_CASE_NAMES": {
              "type": "array",
              "description": "Select Time History Load Case List.",
              "items": {
                "type": "string"
              }
            },
            "SECTION_POSITION": {
              "type": "array",
              "description": "Select Section Position.",
              "items": {
                "type": "string"
              }
            },
            "PART": {
              "type": "array",
              "description": "Part.",
              "items": {
                "type": "string"
              }
            },
            "DISP_OPT": {
              "type": "string",
              "description": "Select Displacement Option. Case-insensitive.",
              "enum": [
                "ACCUMULATIVE",
                "CURRENT",
                "REAL"
              ]
            },
            "OPT_CS": {
              "type": "boolean",
              "description": "It is a flag that extracts the results of the construction stage in the completed state. true -> first construction stage; false -> final stage."
            },
            "STAGE_STEP": {
              "type": "array",
              "description": "Select Stage Step.",
              "items": {
                "type": "string"
              }
            },
            "FIBER_CELL_MINMAX": {
              "type": "boolean",
              "description": "All Fiber Cell Min/Max Stain Table."
            },
            "ADDITIONAL": {
              "type": "object",
              "description": "Additional inputs (DTO_TABLE_ADDITIONAL).",
              "properties": {
                "SET_TENDON_PARAMS": {
                  "type": "object",
                  "description": "Set Tendon Parameters (DTO_TABLE_ADDITIONAL_SET_TENDON_KEY_STAGE).",
                  "properties": {
                    "TENDON_GROUP": {
                      "type": "array",
                      "description": "Tendon Group.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "STAGE": {
                      "type": "array",
                      "description": "Stage.",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "SET_STAGE": {
                  "type": "object",
                  "description": "Set Stage Parameters (DTO_TABLE_ADDITIONAL_SET_STAGE).",
                  "properties": {
                    "STAGE": {
                      "type": "string",
                      "description": "Stage."
                    }
                  }
                },
                "SET_REACTION_PARAMS": {
                  "type": "object",
                  "description": "Set Reaction Parameters (DTO_TABLE_ADDITIONAL_SET_REACTION_PARAMS).",
                  "properties": {
                    "GROUP_NAME": {
                      "type": "string",
                      "description": "Group Name."
                    },
                    "NODE_KEY": {
                      "type": "integer",
                      "description": "Node Key."
                    },
                    "COMPONENT": {
                      "type": "string",
                      "description": "Component.",
                      "default": "1111111"
                    }
                  }
                }
              }
            },
            "COMPONENTS": {
              "type": "array",
              "description": "Select Components.",
              "items": {
                "type": "string"
              }
            },
            "ITEM_TO_DISPLAY": {
              "type": "array",
              "description": "Result Items to Display (View By Max Value Only).",
              "items": {
                "type": "string"
              }
            },
            "TOP_BOT": {
              "type": "array",
              "description": "Top/Bottom filter (PSC BDCW). Exact labels: \"Top\", \"Bottom\".",
              "items": {
                "type": "string"
              }
            },
            "COMP_TENS": {
              "type": "array",
              "description": "Compression/Tension filter (PSC FYSG/FYCM/FSSG/FPMS/FPMT). Exact labels: \"Compression\", \"Tension\".",
              "items": {
                "type": "string"
              }
            },
            "POS_NEG": {
              "type": "array",
              "description": "Positive/Negative filter (PSC BDCY). Exact labels: \"Positive\", \"Negative\".",
              "items": {
                "type": "string"
              }
            },
            "MAX_MIN": {
              "type": "array",
              "description": "Max/Min filter (PSC CUMS, CRMT). Exact labels: \"Max\", \"Min\" for CUMS; \"V-Max\", \"V-Min\", \"T-Max\" for CRMT (hyphen required).",
              "items": {
                "type": "string"
              }
            },
            "TENDON": {
              "type": "object",
              "description": "Tendon ID list (PSC FYPC). KEYS or TO range, same shape as NODE_ELEMS (DTO_TABLE_TENDON_SELECTION).",
              "properties": {
                "KEYS": {
                  "type": "array",
                  "description": "Specify Each Tendon ID.",
                  "items": {
                    "type": "integer"
                  }
                },
                "TO": {
                  "type": "string",
                  "description": "Specify Tendon ID Range (e.g. 1to10)."
                }
              }
            },
            "RATING_CASE": {
              "type": "array",
              "description": "Rating Case filter (PSC RATING_* tables). Labels match model rating case names.",
              "items": {
                "type": "string"
              }
            },
            "GIRDER_SLAB": {
              "type": "string",
              "description": "Girder/Slab filter (PSC RATING_SER_* tables). Accepts \"Girder\" or \"Slab\"."
            }
          }
        }
      }
    }
  },
  "example": {
    "Argument": {
      "TABLE_TYPE": "BEAMFORCE",
      "UNIT": {
        "FORCE": "KN",
        "DIST": "M"
      },
      "STYLES": {
        "FORMAT": "FIXED",
        "PLACE": 3
      },
      "NODE_ELEMS": {
        "KEYS": [
          1,
          2,
          3
        ],
        "TO": "1to5"
      },
      "LOAD_CASE_NAMES": [
        "Dead Load",
        "Live Load"
      ],
      "COMPONENTS": [
        "Axial",
        "Shear-y",
        "Moment-z"
      ]
    }
  }
}