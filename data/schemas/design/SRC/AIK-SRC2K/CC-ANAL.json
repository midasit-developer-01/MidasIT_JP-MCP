{
  "_group": "design",
  "_name": "CC-ANAL",
  "uri": "design/SRC/AIK-SRC2K/CC-ANAL",
  "methods": "POST",
  "schema": {
    "CC-ANAL": {
      "type": "object",
      "description": "SRC Column Check Analysis (CC-ANAL). Fields are driven by the DESIGN_ANAL request DTO: PERFORM_TYPE selects the target scope and ELEMS/SECTIONS narrow it accordingly.",
      "properties": {
        "Argument": {
          "type": "object",
          "properties": {
            "PERFORM_TYPE": {
              "type": "string",
              "enum": ["ALL", "ELEMS", "SECTIONS"],
              "default": "ALL",
              "description": "Perform Target - All Elements: ALL / By Element No.: ELEMS / By Section No.: SECTIONS. Case-insensitive."
            },
            "ELEMS": {
              "type": "object",
              "description": "[PERFORM_TYPE=ELEMS] Element No. Object.",
              "properties": {
                "KEYS": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "Specify Each ID - Element No."
                },
                "TO": {
                  "type": "string",
                  "description": "Specify ID Range - Element Range (e.g. 1-10)"
                },
                "STRUCTURE_GROUP_NAME": {
                  "type": "string",
                  "description": "Structure Group Name"
                }
              }
            },
            "SECTIONS": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "[PERFORM_TYPE=SECTIONS] Section No."
            }
          }
        }
      }
    }
  },
  "example": {
    "Argument": {
      "PERFORM_TYPE": "ELEMS",
      "ELEMS": {
        "KEYS": [1, 2, 3],
        "TO": "1-10",
        "STRUCTURE_GROUP_NAME": "SG1"
      }
    }
  }
}
