{
  "_group": "design",
  "_name": "EQCT",
  "uri": "design/SRC/AIK-SRC2K/EQCT",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "EQCT": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Seismic Load Combination Member Type (EQCT). The single field assigns the seismic member type applied to the member.",
      "properties": {
        "TYPE": {
          "type": "string",
          "enum": [
            "Special Seismic Loads",
            "Vertical Seismic Forces"
          ],
          "description": "Assign Member Type. Case-insensitive enum (matched by wire string). Special Seismic Loads or Vertical Seismic Forces."
        }
      },
      "required": [
        "TYPE"
      ]
    }
  },
  "example": {
    "Assign": {
      "1": {
        "TYPE": "Special Seismic Loads"
      },
      "2": {
        "TYPE": "Vertical Seismic Forces"
      }
    }
  }
}
