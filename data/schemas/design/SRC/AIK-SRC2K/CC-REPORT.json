{
  "_group": "design",
  "_name": "CC-REPORT",
  "uri": "design/SRC/AIK-SRC2K/CC-REPORT",
  "methods": "POST",
  "schema": {
    "CC-REPORT": {
      "type": "object",
      "description": "SRC Column Check Design Report (CC-REPORT). Generates a design report file for SRC column checking; fields are driven by the REPORT_REQUEST DTO which selects report type/mode, export target, and element/section scope.",
      "properties": {
        "Argument": {
          "type": "object",
          "description": "Report generation request (REPORT_REQUEST).",
          "properties": {
            "REPORT_TYPE": {
              "type": "string",
              "description": "Report Type. Case-insensitive.",
              "enum": ["MEMB", "PROP"]
            },
            "EXPORT_PATH": {
              "type": "string",
              "description": "Export directory path (e.g. C:\\MIDAS\\Report\\)."
            },
            "OUTPUT_NAME": {
              "type": "string",
              "description": "Output file name."
            },
            "CURRENT_MODE": {
              "type": "string",
              "description": "Report Mode. Case-insensitive.",
              "enum": ["Graphic", "Detail", "Summary", "PMCurve"]
            },
            "CURRENT_MODE_MEMB": {
              "type": "string",
              "description": "Report Mode used when REPORT_TYPE=MEMB. Case-insensitive.",
              "enum": ["Graphic", "Detail", "Summary", "PMCurve"]
            },
            "CURRENT_MODE_PROP": {
              "type": "string",
              "description": "Report Mode used when REPORT_TYPE=PROP. Case-insensitive.",
              "enum": ["Graphic", "Detail", "Summary", "PMCurve"]
            },
            "ELEMS": {
              "type": "object",
              "description": "Element selection object for the report scope.",
              "properties": {
                "KEYS": {
                  "type": "array",
                  "description": "Specify each element ID.",
                  "items": {
                    "type": "integer"
                  }
                },
                "TO": {
                  "type": "string",
                  "description": "Specify element ID range (e.g. 1-10)."
                },
                "STRUCTURE_GROUP_NAME": {
                  "type": "string",
                  "description": "Structure group name."
                }
              }
            },
            "SECTIONS": {
              "type": "array",
              "description": "Section numbers to include in the report.",
              "items": {
                "type": "integer"
              }
            },
            "DETAIL_POSITIONS": {
              "type": "object",
              "description": "Detail print positions (for RC Beam Design MEMB mode).",
              "properties": {
                "END_I": {
                  "type": "boolean",
                  "description": "Include End I position.",
                  "default": true
                },
                "MID": {
                  "type": "boolean",
                  "description": "Include Mid position.",
                  "default": false
                },
                "END_J": {
                  "type": "boolean",
                  "description": "Include End J position.",
                  "default": false
                }
              }
            }
          },
          "required": ["REPORT_TYPE", "EXPORT_PATH", "OUTPUT_NAME"]
        }
      }
    }
  },
  "example": {
    "Argument": {
      "REPORT_TYPE": "MEMB",
      "EXPORT_PATH": "C:\\MIDAS\\Report\\",
      "OUTPUT_NAME": "SRC_Column_Check_Report",
      "CURRENT_MODE": "Detail",
      "ELEMS": {
        "KEYS": [1, 2, 3],
        "TO": "1-10"
      },
      "SECTIONS": [1, 2],
      "DETAIL_POSITIONS": {
        "END_I": true,
        "MID": false,
        "END_J": true
      }
    }
  }
}
