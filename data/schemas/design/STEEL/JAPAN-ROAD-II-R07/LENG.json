{
  "_group": "design",
  "_name": "LENG",
  "uri": "design/STEEL/JAPAN-ROAD-II-R07/LENG",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "LENG": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Unbraced Length - Japan Road, Steel Part II (LENG). Per-element unbraced length parameters used by the Japan Road steel design check; keyed by element id under Assign.",
      "properties": {
        "LY": {
          "type": "number",
          "default": 0,
          "description": "Unbraced Length Ly (about strong axis)."
        },
        "LZ": {
          "type": "number",
          "default": 0,
          "description": "Unbraced Length Lz (about weak axis)."
        },
        "LB": {
          "type": "number",
          "default": 0,
          "description": "Laterally Unbraced Length."
        },
        "bNOTUSE": {
          "type": "boolean",
          "default": false,
          "description": "Do not consider the laterally unbraced length."
        },
        "bAUTOCALC": {
          "type": "boolean",
          "default": false,
          "description": "Calculate the unbraced length automatically by the design code."
        },
        "LT": {
          "type": "number",
          "default": 0,
          "description": "Torsional Unbraced Length."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "example": {
    "Assign": {
      "1": {
        "LY": 3.5,
        "LZ": 3.5,
        "LB": 3.5,
        "bNOTUSE": false,
        "bAUTOCALC": false,
        "LT": 3.5
      }
    }
  }
}
