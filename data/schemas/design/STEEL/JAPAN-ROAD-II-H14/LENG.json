{
  "_group": "design",
  "_name": "LENG",
  "uri": "design/STEEL/JAPAN-ROAD-II-H14/LENG",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "LENG": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Unbraced Length - Japan Road (Steel, Part II) (LENG). Defines member unbraced lengths for buckling checks; each value is stored per assigned element key.",
      "properties": {
        "LY": {
          "type": "number",
          "default": 0,
          "description": "Unbraced Length Ly (about strong axis)."
        },
        "LZ": {
          "type": "number",
          "default": 0,
          "description": "Unbraced Length Lz (about weak axis)."
        },
        "LB": {
          "type": "number",
          "default": 0,
          "description": "Laterally Unbraced Length."
        },
        "bNOTUSE": {
          "type": "boolean",
          "default": false,
          "description": "Do not consider the laterally unbraced length."
        },
        "bAUTOCALC": {
          "type": "boolean",
          "default": false,
          "description": "Calculate unbraced length by code."
        },
        "LT": {
          "type": "number",
          "default": 0,
          "description": "Torsional Unbraced Length."
        }
      }
    }
  },
  "example": {
    "Assign": {
      "1": {
        "LY": 4.0,
        "LZ": 4.0,
        "LB": 4.0,
        "bNOTUSE": false,
        "bAUTOCALC": false,
        "LT": 4.0
      }
    }
  }
}
