{
  "_group": "design",
  "_name": "EQCT",
  "uri": "design/STEEL/KDS-41-30-2022/EQCT",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "EQCT": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Seismic Load Combination Member Type (EQCT). The single field TYPE assigns the seismic member type used by the design code combination handler.",
      "properties": {
        "TYPE": {
          "type": "string",
          "enum": [
            "Special Seismic Loads",
            "Vertical Seismic Forces"
          ],
          "description": "Assign member type for the seismic load combination. Case-insensitive."
        }
      },
      "required": [
        "TYPE"
      ]
    }
  },
  "example": {
    "Assign": {
      "1": {
        "TYPE": "Special Seismic Loads"
      },
      "2": {
        "TYPE": "Vertical Seismic Forces"
      }
    }
  }
}
