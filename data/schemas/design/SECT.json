{
  "_group": "design",
  "_name": "SECT",
  "uri": "design/SECT",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "SECT": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Section (SECT). Fields are driven by the section Type (SECTTYPE): a section carries a 'before' and 'after' geometry (SECT_BEFORE/SECT_AFTER), an optional composite tapered J base, and coating/forming/recalculation options; SPC_TEXT can import geometry from an SPC string.",
      "additionalProperties": true,
      "required": [
        "SECTTYPE",
        "SECT_NAME"
      ],
      "properties": {
        "SECTTYPE": {
          "type": "string",
          "description": "Type. Section type. Case-insensitive matching.",
          "enum": [
            "DBUSER",
            "SRC",
            "VALUE",
            "COMBINED",
            "TAPERED",
            "CONSTRUCT",
            "COMPOSITE",
            "PSC",
            "COMPOSITE-GEN",
            "SOD",
            "SB"
          ]
        },
        "SECT_NAME": {
          "type": "string",
          "description": "Sect Name."
        },
        "SECT_BEFORE": {
          "$ref": "#/definitions/SECT_SECTION",
          "description": "Sect Before. 'Before' section geometry/definition."
        },
        "SECT_AFTER": {
          "$ref": "#/definitions/SECT_SECTION",
          "description": "Sect After. 'After' section geometry/definition (used for tapered sections)."
        },
        "COMPOSITE_J": {
          "$ref": "#/definitions/SECT_SECTBASE",
          "description": "Composite Tapered J. Section base for the J end of a composite tapered section."
        },
        "COAT_THIK": {
          "type": "number",
          "description": "Coating Thickness."
        },
        "FORM_TYPE": {
          "type": "integer",
          "description": "Forming Type."
        },
        "RECL_PROP": {
          "type": "boolean",
          "description": "Recalc Sect Properties. When true, section properties are recalculated on set."
        },
        "CALC_OPT": {
          "type": "boolean",
          "description": "Caculate Sect Prop. Option."
        },
        "SPC_TEXT": {
          "type": "string",
          "description": "SPC TEXT. When assigned and non-empty, section data is imported from this SPC string."
        },
        "SPC_TEXT2": {
          "type": "string",
          "description": "SPC TEXT2. Second SPC string; when both SPC_TEXT and SPC_TEXT2 are set the section is built as a tapered composite-general."
        }
      },
