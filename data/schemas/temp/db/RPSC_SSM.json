        "bMbarSameJ": {
          "type": "boolean",
          "description": "Main bar I==J (same at both ends).",
          "default": true
        },
        "bSbarSameJ": {
          "type": "boolean",
          "description": "Shear bar I==J (same at both ends).",
          "default": true
        },
        "Mbar_I": {
          "type": "array",
          "description": "Main bars at I-end.",
          "items": {
            "type": "object",
            "description": "PSC main (longitudinal) bar (RPSC_MBAR_SSM).",
            "properties": {
              "nType": {
                "type": "integer",
                "description": "Type (0: Point, 1: Line, 2: Arc, 3: Circle, 4: Poly Line)."
              },
              "nRefY": {
                "type": "integer",
                "description": "Ref Y (0: Left, 1: Center, 2: Right)."
              },
              "nRefZ": {
                "type": "integer",
                "description": "Ref Z (0: Top, 1: Center, 2: Bottom)."
              },
              "Start": {
                "type": "object",
                "description": "Rebar placement coordinate point (POINT_SSM).",
                "properties": {
                  "dPointY": {
                    "type": "number",
                    "description": "Point Y coordinate."
                  },
                  "dPointZ": {
                    "type": "number",
                    "description": "Point Z coordinate."
                  }
                },
                "required": [
                  "dPointY",
                  "dPointZ"
                ]
              },
