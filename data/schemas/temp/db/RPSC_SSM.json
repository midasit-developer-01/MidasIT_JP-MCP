              "dRadius": {
                "type": "number",
                "description": "Radius."
              },
              "nNumorCTC": {
                "type": "integer",
                "description": "Num or CTC (0: Num, 1: CTC)."
              },
              "nNum": {
                "type": "integer",
                "description": "Number of bars."
              },
              "dCTC": {
                "type": "number",
                "description": "CTC (center-to-center spacing)."
              },
              "bEdgeBar": {
                "type": "boolean",
