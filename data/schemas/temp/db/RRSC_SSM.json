              },
              "nRebarPlacingType": {
                "type": "integer",
                "description": "Rebar placing type (1: SpacingDist, 2: OffsetDist, 3: SpacingAngle, 4: OffsetAngle)."
              },
              "dOffsetAngle": {
                "type": "number",
                "description": "Offset/spacing angle."
              },
              "dCoverThickness": {
                "type": "number",
                "description": "Cover thickness."
              },
              "nRebarNum": {
                "type": "integer",
                "description": "Number of rebars."
              },
              "strRebarDia": {
                "type": "string",
                "description": "Rebar diameter (name)."
              },
              "dUserRebarDia": {
                "type": "number",
                "description": "User-defined rebar diameter."
              },
              "bEmbedmentRebar": {
                "type": "boolean",
                "description": "Embedment (anchorage) rebar."
              },
              "dOffsetDistStt": {
                "type": "number",
                "description": "Offset distance - start."
              },
              "dOffsetDistEnd": {
                "type": "number",
                "description": "Offset distance - end."
              },
              "strBarSpacing": {
