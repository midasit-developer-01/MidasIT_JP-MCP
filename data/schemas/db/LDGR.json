{
  "_group": "db",
  "_name": "LDGR",
  "uri": "db/LDGR",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "LDGR": {
      "$schema": "http://json-schema.org/draft-07/schema#",
