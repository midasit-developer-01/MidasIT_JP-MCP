      "properties": {
        "NAME": {
          "description": "Load group name. Assigned to the load group's GroupName on set.",
          "type": "string"
        }
      },
      "required": [
        "NAME"
      ]
    }
  },
  "example": {
    "Assign": {
      "1": {
        "NAME": "SW"
      },
      "2": {
        "NAME": "WetConcrete"
      }
    }
  },
  "manual_title": "Load Group",
