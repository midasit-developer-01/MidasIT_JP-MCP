{
  "_group": "db",
  "_name": "SECV",
  "uri": "db/SECV",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "SECV": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Section Variation (SECV). A section-variation record keyed by a VBEM element key (the key must already exist as a VBEM key); it reuses the SECT section layout but the write path only accepts SECTTYPE=COMPOSITE and, if SECT_BEFORE.SHAPE is given, it must be 'GI', with SECT_BEFORE carrying the main section geometry/offset/material data.",
      "type": "object",
      "properties": {
        "SECTTYPE": {
          "type": "string",
          "enum": [
            "DBUSER",
            "SRC",
            "VALUE",
            "COMBINED",
            "TAPERED",
            "CONSTRUCT",
            "COMPOSITE",
            "PSC",
            "COMPOSITE-GEN",
            "SOD",
            "SB"
          ],
          "description": "Section data type (wire value, case-insensitive). On write (POST/PUT) the handler hard-requires the value COMPOSITE (steel-concrete composite); any other value is rejected. Other enum members are only meaningful when reading back the underlying section."
        },
        "SECT_NAME": {
          "type": "string",
          "description": "Section name."
        },
        "SECT_BEFORE": {
          "$ref": "#/definitions/SECT_SECTION",
          "description": "Primary section data ('Before' part) holding the main composite section geometry, offset, material and slab data. If its SHAPE field is assigned it must equal 'GI' (composite steel girder); otherwise the write is rejected."
        },
        "SECT_AFTER": {
          "$ref": "#/definitions/SECT_SECTION",
          "description": "Secondary ('After' part) section data; carried through for compatibility with the SECT layout but not used for a plain COMPOSITE section."
        },
        "COMPOSITE_J": {
          "$ref": "#/definitions/SECT_SECTBASE",
          "description": "Base section at end J for a composite tapered section; carried through from the SECT layout, generally not needed for a plain COMPOSITE section."
        }
      },
      "required": [
        "SECTTYPE",
        "SECT_NAME"
      ],
      "definitions": {
        "STIFF_SHAPE": {
          "type": "object",
          "properties": {
            "NAME": {
              "type": "string",
              "description": "Stiffener shape name."
            },
            "SHAPE_TYPE": {
              "type": "integer",
              "description": "Stiffener shape type code."
            },
            "SIZE": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "number"
              },
              "description": "Stiffener shape dimensions (fixed 8 values)."
            }
          }
        },
        "STIFF_PROFILE": {
          "type": "object",
          "properties": {
            "SPACING": {
              "type": "number",
              "description": "Stiffener spacing."
            },
            "SHAPE": {
              "type": "integer",
              "description": "Index of the stiffener shape used on this edge."
            },
            "USE_CALC": {
              "type": "boolean",
              "description": "Use auto-calculation for this stiffener profile.",
              "default": false
            }
          }
        },
        "SECT_STIFF": {
          "type": "object",
          "properties": {
            "POSITION": {
              "type": "integer",
              "description": "Stiffener position code."
            },
            "REFERENCE_OF_D": {
              "type": "integer",
              "description": "Reference of d for stiffener placement."
            },
            "STIFF_CNT": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer"
              },
              "description": "Stiffener counts (fixed 4 values: top/bot/left/right)."
            },
            "STIFF_SHAPE": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/STIFF_SHAPE"
              },
              "description": "Stiffener shape definitions."
            },
            "STIFF_TOP": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/STIFF_PROFILE"
              },
              "description": "Top-edge stiffener profiles."
            },
            "STIFF_BOT": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/STIFF_PROFILE"
              },
              "description": "Bottom-edge stiffener profiles."
            },
            "STIFF_LEFT": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/STIFF_PROFILE"
              },
              "description": "Left-edge stiffener profiles."
            },
            "STIFF_RIGHT": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/STIFF_PROFILE"
              },
              "description": "Right-edge stiffener profiles."
            }
          }
        },
        "SECT_DESIGN": {
          "type": "object",
          "properties": {
            "YBAR": {
              "type": "number",
              "description": "Design centroid distance Y."
            },
            "ZBAR": {
              "type": "number",
              "description": "Design centroid distance Z."
            },
            "ZYY": {
              "type": "number",
              "description": "Design section modulus about y-axis."
            },
            "ZZZ": {
              "type": "number",
              "description": "Design section modulus about z-axis."
            },
            "TANA": {
              "type": "number",
              "description": "Design tan(alpha) principal-axis angle."
            },
            "BETA": {
              "type": "number",
              "description": "Design beta angle."
            }
          }
        },
        "SECT_STIFFNESS": {
          "type": "object",
          "properties": {
            "AREA": {
              "type": "number",
              "description": "Cross-sectional area."
            },
            "WAREA": {
              "type": "number",
              "description": "Effective/weighted area."
            },
            "ASY": {
              "type": "number",
              "description": "Effective shear area about y."
            },
            "ASZ": {
              "type": "number",
              "description": "Effective shear area about z."
            },
            "RXX": {
              "type": "number",
              "description": "Torsional constant (Ixx)."
            },
            "RYY": {
              "type": "number",
              "description": "Moment of inertia about y (Iyy)."
            },
            "RZZ": {
              "type": "number",
              "description": "Moment of inertia about z (Izz)."
            },
            "CYP": {
              "type": "number",
              "description": "Distance to extreme fiber +y."
            },
            "CYM": {
              "type": "number",
              "description": "Distance to extreme fiber -y."
            },
            "CZP": {
              "type": "number",
              "description": "Distance to extreme fiber +z."
            },
            "CZM": {
              "type": "number",
              "description": "Distance to extreme fiber -z."
            },
            "QYB": {
              "type": "number",
              "description": "First moment of area Qy at shear check point."
            },
            "QZB": {
              "type": "number",
              "description": "First moment of area Qz at shear check point."
            },
            "Y": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              },
              "description": "Stress-point y coordinates (fixed 4 values)."
            },
            "Z": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              },
              "description": "Stress-point z coordinates (fixed 4 values)."
            },
            "IW": {
              "type": "number",
              "description": "Warping constant."
            },
            "W": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              },
              "description": "Warping function values (fixed 4 values)."
            },
            "CXY": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              },
              "description": "Shear coefficient Cxy at stress points (fixed 4 values)."
            },
            "CXZ": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              },
              "description": "Shear coefficient Cxz at stress points (fixed 4 values)."
            },
            "YS_YC": {
              "type": "number",
              "description": "Shear-center minus centroid distance in y."
            },
            "ZS_ZC": {
              "type": "number",
              "description": "Shear-center minus centroid distance in z."
            },
            "IP": {
              "type": "number",
              "description": "Polar moment of inertia."
            }
          }
        },
        "SECT_STIFFNESS_CF_BASE": {
          "type": "object",
          "properties": {
            "A_EFF": {
              "type": "number",
              "description": "Effective area (cold-formed ULS)."
            },
            "A_NET": {
              "type": "number",
              "description": "Net area (cold-formed ULS)."
            },
            "LY_EFF": {
              "type": "number",
              "description": "Effective Iy (cold-formed ULS)."
            },
            "LZ_EFF": {
              "type": "number",
              "description": "Effective Iz (cold-formed ULS)."
            },
            "WY_EFF": {
              "type": "number",
              "description": "Effective Wy (cold-formed ULS)."
            },
            "WZ_EFF": {
              "type": "number",
              "description": "Effective Wz (cold-formed ULS)."
            },
            "LT_EFF": {
              "type": "number",
              "description": "Effective It (cold-formed ULS)."
            },
            "LW_EFF": {
              "type": "number",
              "description": "Effective Iw (cold-formed ULS)."
            },
            "RY_EFF": {
              "type": "number",
              "description": "Effective radius of gyration ry (cold-formed ULS)."
            },
            "RZ_EFF": {
              "type": "number",
              "description": "Effective radius of gyration rz (cold-formed ULS)."
            }
          }
        },
        "SECT_SOD_STIFF_DATA": {
          "type": "object",
          "properties": {
            "USE_CALC": {
              "type": "boolean",
              "description": "Use auto-calculation for this SOD stiffener data.",
              "default": false
            },
            "SPACING": {
              "type": "number",
              "description": "Stiffener spacing."
            },
            "STIF_POS": {
              "type": "integer",
              "description": "Stiffener position code."
            },
            "SHAPE_NAME": {
              "type": "string",
              "description": "Stiffener shape name."
            },
            "STIF_NAME": {
              "type": "string",
              "description": "Stiffener name."
            }
          }
        },
        "SECT_SOD_STIFF_SUB": {
          "type": "object",
          "properties": {
            "DECK_POS": {
              "type": "integer",
              "description": "Deck position code."
            },
            "DECK_PART": {
              "type": "integer",
              "description": "Deck part index."
            },
            "REF_POS": {
              "type": "integer",
              "description": "Reference position code."
            },
            "NUM": {
              "type": "integer",
              "description": "Stiffener number."
            },
            "DECK_NAME": {
              "type": "string",
              "description": "Deck name."
            },
            "EACHSTIFFNOS": {
              "type": "integer",
              "description": "Applied stiffener number."
            },
            "DATA": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SECT_SOD_STIFF_DATA"
              },
              "description": "SOD stiffener data entries."
            }
          }
        },
        "SECT_SOD_STIFF": {
          "type": "object",
          "properties": {
            "TOSTIFNOS": {
              "type": "integer",
              "description": "Defined stiffener number."
            },
            "SHAPE": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/STIFF_SHAPE"
              },
              "description": "Stiffener shape definitions."
            },
            "DECKSTIFFNO": {
              "type": "integer",
              "description": "Total deck & stiffener number."
            },
            "SUB": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SECT_SOD_STIFF_SUB"
              },
              "description": "SOD stiffener sub-definitions."
            }
          }
        },
        "GSEC_VERTEX": {
          "type": "object",
          "properties": {
            "X": {
              "type": "number",
              "description": "Vertex X coordinate."
            },
            "Y": {
              "type": "number",
              "description": "Vertex Y coordinate."
            }
          }
        },
        "GSEC_POLYGON": {
          "type": "object",
          "properties": {
            "VERTEX": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_VERTEX"
              },
              "description": "Polygon vertices."
            }
          }
        },
        "GSEC_LINE": {
          "type": "object",
          "properties": {
            "VERTEX_ID1": {
              "type": "integer",
              "description": "Start vertex id."
            },
            "VERTEX_ID2": {
              "type": "integer",
              "description": "End vertex id."
            },
            "ALIGN": {
              "type": "integer",
              "description": "Line alignment information code."
            },
            "THICK": {
              "type": "number",
              "description": "Line thickness."
            },
            "ROTATE_DIS": {
              "type": "number",
              "description": "Rotating distance."
            },
            "SHEAR_STRESS": {
              "type": "number",
              "description": "Shear stress on line."
            }
          }
        },
        "GSEC_LDGN": {
          "type": "object",
          "properties": {
            "NAME": {
              "type": "string",
              "description": "Longitudinal-stiffener group name."
            },
            "BOUNDARY": {
              "type": "integer",
              "description": "Boundary code."
            },
            "PANEL_NUM": {
              "type": "integer",
              "description": "Panel number."
            },
            "LENGTH": {
              "type": "number",
              "description": "Length."
            },
            "THICK": {
              "type": "number",
              "description": "Thickness."
            },
            "Y": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              },
              "description": "Y coordinates (fixed 2 values)."
            },
            "Z": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              },
              "description": "Z coordinates (fixed 2 values)."
            },
            "USE_EXCEPT": {
              "type": "boolean",
              "description": "Use exception flag."
            },
            "USE_STIFF": {
              "type": "boolean",
              "description": "Use stiffener flag."
            },
            "LINE": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_LINE"
              },
              "description": "Lines of the longitudinal-stiffener group."
            }
          }
        },
        "GSEC_LSHAP": {
          "type": "object",
          "properties": {
            "NAME": {
              "type": "string",
              "description": "Longitudinal shape name."
            },
            "SHAPE": {
              "type": "integer",
              "description": "Shape code."
            },
            "LDGN": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_LDGN"
              },
              "description": "Longitudinal-stiffener group definitions."
            }
          }
        },
        "GSEC_PART": {
          "type": "object",
          "properties": {
            "STIFF": {
              "$ref": "#/definitions/SECT_STIFFNESS",
              "description": "Stiffness of this general-section part."
            },
            "STIFF_SUM": {
              "$ref": "#/definitions/SECT_STIFFNESS",
              "description": "Summed stiffness of general-section parts."
            },
            "PERIIN": {
              "type": "number",
              "description": "Inner perimeter."
            },
            "PERIOUT": {
              "type": "number",
              "description": "Outer perimeter."
            },
            "YBAR": {
              "type": "number",
              "description": "Centroid distance Y."
            },
            "ZBAR": {
              "type": "number",
              "description": "Centroid distance Z."
            },
            "PERIIN_SUM": {
              "type": "number",
              "description": "Inner perimeter sum."
            },
            "PERIOUT_SUM": {
              "type": "number",
              "description": "Outer perimeter sum."
            },
            "YBAR_SUM": {
              "type": "number",
              "description": "Centroid Y sum."
            },
            "ZBAR_SUM": {
              "type": "number",
              "description": "Centroid Z sum."
            },
            "DENS_RATIO": {
              "type": "number",
              "description": "Density ratio."
            },
            "ELAST": {
              "type": "number",
              "description": "Elastic modulus of this part."
            },
            "POISSON": {
              "type": "number",
              "description": "Poisson ratio of this part."
            },
            "USE_BASE_MATL": {
              "type": "boolean",
              "description": "Use base material for this part."
            },
            "USE_PLANE": {
              "type": "boolean",
              "description": "Use plane for this part.",
              "default": false
            },
            "IDX_START": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "integer"
              },
              "description": "Start indices (fixed 5 values)."
            },
            "IDX_END": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "integer"
              },
              "description": "End indices (fixed 5 values)."
            }
          }
        },
        "SECT_SECTBASE": {
          "type": "object",
          "properties": {
            "SHAPE": {
              "type": "string",
              "description": "Section shape code string of this base section."
            },
            "DB_NAME": {
              "type": "string",
              "description": "Standard section database name (e.g. AISC, JIS, IS808); empty for user/value sections."
            },
            "SECT_NAME": {
              "type": "string",
              "description": "Base section (DB) name."
            },
            "SECT_NAME2": {
              "type": "string",
              "description": "Secondary base section name (for built-up/combined sections)."
            },
            "vSIZE": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Section dimension list; the meaning/count of each value depends on the section SHAPE."
            },
            "PERIIN": {
              "type": "number",
              "description": "Inner perimeter."
            },
            "PERIOUT": {
              "type": "number",
              "description": "Outer perimeter."
            },
            "BUILT_FLAG": {
              "type": "integer",
              "description": "Built-up flag: 0 for standard DB section, 1 for user/value input."
            },
            "BEFORE_PART_NUM": {
              "type": "integer",
              "description": "Before-part number (used for tapered composite-general sections)."
            },
            "USE_SYM_CALC": {
              "type": "boolean",
              "description": "Use symmetric auto-calculation."
            },
            "CF_STIFF_ULS": {
              "$ref": "#/definitions/SECT_STIFFNESS_CF_BASE",
              "description": "Cold-formed effective ULS stiffness properties."
            },
            "STIFF": {
              "$ref": "#/definitions/SECT_STIFFNESS",
              "description": "User-input/computed stiffness properties (used for VALUE-type sections)."
            },
            "DESIGN": {
              "$ref": "#/definitions/SECT_DESIGN",
              "description": "Design properties."
            },
            "STIFFENER": {
              "$ref": "#/definitions/SECT_STIFF",
              "description": "Stiffener layout."
            },
            "SODSTIFF": {
              "$ref": "#/definitions/SECT_SOD_STIFF",
              "description": "SOD (steel orthotropic deck) stiffener definition."
            },
            "GENERAL_PART": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_PART"
              },
              "description": "General-section parts (composite general or general user sections)."
            },
            "OUTER_POLYGON": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_POLYGON"
              },
              "description": "Outer polygons of a general section."
            },
            "INNER_POLYGON": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_POLYGON"
              },
              "description": "Inner (hole) polygons of a general section."
            },
            "LINE": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_LINE"
              },
              "description": "Section lines."
            },
            "LINE_LOOP": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Line loop indices."
            },
            "SHAPE_ARRAY": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GSEC_LSHAP"
              },
              "description": "Longitudinal shape array."
            },
            "vSIZE_PSC_A": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "PSC section I size group A (PSC sections only)."
            },
            "vSIZE_PSC_B": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "PSC section I size group B (PSC sections only)."
            },
            "vSIZE_PSC_C": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "PSC section I size group C (PSC sections only)."
            },
            "vSIZE_PSC_D": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "PSC section I size group D (PSC sections only)."
            },
            "SWIDTH": {
              "type": "number",
              "description": "S-Width for PSC section I or J."
            }
          }
        },
        "SECT_SECTION": {
          "type": "object",
          "properties": {
            "OFFSET_PT": {
              "type": "string",
              "description": "Cardinal (offset) point code, e.g. 'CC','LT'."
            },
            "OFFSET_CENTER": {
              "type": "integer",
              "description": "Center location: Centroid=0, Center of Section=1."
            },
            "USER_OFFSET_REF": {
              "type": "integer",
              "description": "User-type offset reference: Centroid=0, Extreme Fiber(s)=1."
            },
            "HORZ_OFFSET_OPT": {
              "type": "integer",
              "description": "Horizontal offset option: to Extreme Fiber=0, User=1."
            },
            "USERDEF_OFFSET_YI": {
              "type": "number",
              "description": "User horizontal offset value at I."
            },
            "USERDEF_OFFSET_YJ": {
              "type": "number",
              "description": "User horizontal offset value at J (tapered sections)."
            },
            "VERT_OFFSET_OPT": {
              "type": "integer",
              "description": "Vertical offset option: to Extreme Fiber=0, User=1."
            },
            "USERDEF_OFFSET_ZI": {
              "type": "number",
              "description": "User vertical offset value at I."
            },
            "USERDEF_OFFSET_ZJ": {
              "type": "number",
              "description": "User vertical offset value at J (tapered sections)."
            },
            "USE_SHEAR_DEFORM": {
              "type": "boolean",
              "description": "Consider shear deformation.",
              "default": false
            },
            "USE_WARPING_EFFECT": {
              "type": "boolean",
              "description": "Consider warping effect."
            },
            "SHAPE": {
              "type": "string",
              "description": "Section shape code string. For a SECV write on SECT_BEFORE this, if given, must be 'GI' (composite steel girder)."
            },
            "DATATYPE": {
              "type": "integer",
              "description": "Data type of the section input."
            },
            "TYPE": {
              "type": "integer",
              "description": "Section sub-type code (tapered/section variation type)."
            },
            "SECT_I": {
              "$ref": "#/definitions/SECT_SECTBASE",
              "description": "Base section at end I."
            },
            "SECT_J": {
              "$ref": "#/definitions/SECT_SECTBASE",
              "description": "Base section at end J (tapered/variable sections)."
            },
            "Y_VAR": {
              "type": "integer",
              "description": "Variation type of the section along local-y (LyType) for tapered sections."
            },
            "Z_VAR": {
              "type": "integer",
              "description": "Variation type of the section along local-z (LzType) for tapered sections."
            },
            "SRC_TYPE": {
              "type": "integer",
              "description": "SRC (steel-reinforced concrete) type code."
