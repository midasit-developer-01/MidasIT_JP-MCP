{
  "_group": "db",
  "_name": "STRPSSM",
  "uri": "db/STRPSSM",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "STRPSSM": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Section Manager - Stress Points (STRPSSM). Defines additional (user) stress-check points at the i-end (POINT1) and j-end (POINT2) of a section; POINT_SIZE_1/POINT_SIZE_2 give the point counts and OPT_SAME_J flags whether the j-end reuses the i-end points.",
      "properties": {
        "OPT_SAME_J": {
          "description": "Whether the same additional stress points are used at both the i-end and j-end of the section.",
          "type": "boolean",
          "default": true
        },
        "POINT_SIZE_1": {
          "description": "Number of additional stress points at the i-end (size of POINT1).",
          "type": "integer"
        },
        "POINT_SIZE_2": {
          "description": "Number of additional stress points at the j-end (size of POINT2).",
          "type": "integer"
        },
        "POINT1": {
          "description": "Additional stress point coordinates at the i-end; each item is an object with Y and Z coordinates.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Y": {
                "description": "Point Y coordinate.",
                "type": "number"
              },
              "Z": {
                "description": "Point Z coordinate.",
                "type": "number"
              }
            },
            "required": [
              "Y",
              "Z"
            ]
          }
        },
        "POINT2": {
          "description": "Additional stress point coordinates at the j-end; each item is an object with Y and Z coordinates.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Y": {
                "description": "Point Y coordinate.",
                "type": "number"
              },
              "Z": {
                "description": "Point Z coordinate.",
                "type": "number"
              }
            },
            "required": [
              "Y",
              "Z"
            ]
          }
        }
      },
      "required": [
        "POINT_SIZE_1",
        "POINT_SIZE_2",
        "POINT1",
        "POINT2"
      ]
    }
  },
  "example": {
    "Assign": {
      "9003": {
        "OPT_SAME_J": true,
        "POINT_SIZE_1": 2,
        "POINT_SIZE_2": 2,
        "POINT1": [
          {
            "Y": 0.00583,
            "Z": 0.00476
          },
          {
            "Y": -0.00506,
            "Z": 0.00097
          }
        ],
        "POINT2": [
          {
            "Y": 0.007067356048348719,
            "Z": 0.005572125828318985
          },
          {
            "Y": -0.0059233102292634635,
            "Z": 0.0011354962297204655
          }
        ]
      }
    }
  },
  "manual_title": "Section Manager - Stress Points",
  "manual_url": "https://support.midasuser.com/hc/en-us/articles/35943448721177-Section-Manager-Stress-Points"
}
