{
  "_group": "db",
  "_name": "MVLD",
  "uri": "db/MVLD",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "MVLD": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "description": "Moving Loads (MVLD). TYPE selects which sub-object drives the data: 0 = General/Default (use DEFAULT), 1 = Load Case for Permit Vehicle (use PERMIT_LOAD), 2 = Moving Load Optimization / Auto Optimize (use AUTO_OPTIMIZE); ASL carries the Assigned-Line data used only under the Australia moving-load code when the vehicle Load Model is Heavy Load Platform (LOAD_MODEL=2).",
      "properties": {
        "LCNAME": {
          "description": "Load Case Name.",
          "type": "string"
        },
        "DESC": {
          "description": "Description of the load case.",
          "type": "string",
          "default": ""
        },
        "TYPE": {
          "description": "Load Case Type. 0 = General/Default (fills DEFAULT), 1 = Load Case for Permit Vehicle (fills PERMIT_LOAD), 2 = Moving Load Optimization / Auto Optimize (fills AUTO_OPTIMIZE).",
          "type": "integer"
        },
        "AUTO_OPTIMIZE": {
          "description": "[TYPE=2] Moving Load Optimization (Auto Optimize) data.",
          "type": "object",
          "properties": {
            "VEHICLE_LOAD_NAME": {
              "description": "Vehicle Load name.",
              "type": "string",
              "default": ""
            },
            "LANE_NAME": {
              "description": "Optimization lane name; must reference an existing (surface or line) lane.",
              "type": "string",
              "default": ""
            },
            "SCALE_FACTORS": {
              "description": "Set of scale factors (multiple presence factors). Only the first 6 values are used ([L1, L2, L3, L4, L5, L6]).",
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "MIN_VEHL_DIST": {
              "description": "Minimum vehicle distance.",
              "type": "number"
            },
            "MIN_NUM_VEHICLE": {
              "description": "Minimum number of vehicles.",
              "type": "integer"
            },
            "MAX_NUM_VEHICLE": {
              "description": "Maximum number of vehicles.",
              "type": "integer"
            },
            "OPTIMIZE_ITEMS": {
              "description": "Assignment vehicles for the optimization.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "VEHICLE_TYPE": {
                    "description": "Vehicle class. VC = Vehicle Class, VL = Vehicle Load. Case-insensitive.",
                    "type": "string",
                    "enum": ["VC", "VL"]
                  },
                  "VEHICLE_NAME": {
                    "description": "Vehicle name; when VEHICLE_TYPE=VC must match an existing vehicle class, when VL an existing vehicle load.",
                    "type": "string"
                  },
                  "SCALE_FACTOR": {
                    "description": "Vehicle scale factor.",
                    "type": "number"
                  }
                },
                "required": ["VEHICLE_TYPE", "VEHICLE_NAME", "SCALE_FACTOR"]
              }
            },
            "FATIGUE": {
              "description": "Fatigue option (ignored under the Australia code, where fatigue is derived from LOAD_MODEL).",
              "type": "boolean",
              "default": false
            },
            "NUM_LOADED_LANES": {
              "description": "Number of loaded lanes.",
              "type": "integer"
            },
            "LOAD_MODEL": {
              "description": "Load model index. Under the Australia code LOAD_MODEL=1 implies fatigue and LOAD_MODEL=2 (Heavy Load Platform) enables the ASL / Assigned-Line data.",
              "type": "integer",
              "default": 0
            }
          }
        },
        "PERMIT_LOAD": {
          "description": "[TYPE=1] Load Case for Permit Vehicle data.",
          "type": "object",
          "properties": {
            "VEHICLE_LOAD_NAME": {
              "description": "Permit vehicle load name; must reference an existing vehicle load.",
              "type": "string"
            },
            "REF_LANE": {
              "description": "Reference lane name; must reference an existing (surface or line) lane.",
              "type": "string"
            },
            "SCALE_FACTOR": {
              "description": "Permit scale factor.",
              "type": "number"
            }
          },
          "required": ["VEHICLE_LOAD_NAME", "REF_LANE", "SCALE_FACTOR"]
        },
        "ASL": {
          "description": "Assigned Line data. Applied only under the Australia moving-load code when the vehicle Load Model is Heavy Load Platform (LOAD_MODEL=2), and combined with either the DEFAULT (TYPE=0) or AUTO_OPTIMIZE (TYPE=2) path.",
          "type": "object",
          "properties": {
            "MULTIPLE_FACTOR": {
              "description": "Multiple presence / unobstructed-lane scale factor.",
              "type": "number"
            },
            "VEHICLE_LOAD_NAME": {
              "description": "Primary vehicle load name; must reference an existing vehicle load.",
              "type": "string"
            },
            "VEHICLE_LOAD_NAME2": {
              "description": "Secondary vehicle load name; use \"NONE\" when there is no second vehicle.",
              "type": "string"
            },
            "MIN_LOADED_LANE": {
              "description": "Minimum number of loaded lanes.",
              "type": "integer"
            },
            "MAX_LOADED_LANE": {
              "description": "Maximum number of loaded lanes.",
              "type": "integer"
            },
            "LINE_ITEMS": {
              "description": "Selected and straddling lane assignments.",
              "type": "object",
              "properties": {
                "NA_LLAN_NAMES": {
                  "description": "Selected line/lane names.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "STRAD_LLAN1_NAMES": {
                  "description": "Straddling lane 1 names (paired with STRAD_LLAN2_NAMES).",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "STRAD_LLAN2_NAMES": {
                  "description": "Straddling lane 2 names (paired with STRAD_LLAN1_NAMES).",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["NA_LLAN_NAMES", "STRAD_LLAN1_NAMES", "STRAD_LLAN2_NAMES"]
            }
          },
          "required": [
            "MULTIPLE_FACTOR",
            "VEHICLE_LOAD_NAME",
            "VEHICLE_LOAD_NAME2",
            "MIN_LOADED_LANE",
            "MAX_LOADED_LANE",
            "LINE_ITEMS"
          ]
        },
        "DEFAULT": {
          "description": "[TYPE=0] General/Default data.",
          "type": "object",
          "properties": {
            "LANE_FACTOR_TYPE": {
              "description": "Lane factor type. Under the Korea code, non-zero (e.g. 1) uses the SCALE_FACTORS multiple-presence factors, while 0 uses the individual _2_LANE_/_3_LANE_ factors.",
              "type": "integer"
            },
            "SCALE_FACTORS": {
              "description": "Set of scale factors (multiple presence factors). Only the first 6 values are used ([L1, L2, L3, L4, L5, L6]).",
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "COMB_OPTION": {
              "description": "Loading effect combination option. COMBINED or INDEPENDENT. Case-insensitive.",
              "type": "string",
              "enum": ["COMBINED", "INDEPENDENT"],
              "default": "COMBINED"
            },
            "SUB_LOAD_DATAS": {
              "description": "Set of sub load data (per-vehicle sub load cases).",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "VEHICLE_TYPE": {
                    "description": "Vehicle class. VC = Vehicle Class, VL = Vehicle Load. Case-insensitive.",
                    "type": "string",
                    "enum": ["VC", "VL"]
                  },
                  "VEHICLE_NAME": {
                    "description": "Vehicle name; when VEHICLE_TYPE=VC must match an existing vehicle class, when VL an existing vehicle load.",
                    "type": "string"
                  },
                  "SCALE_FACTOR": {
                    "description": "Vehicle scale factor.",
                    "type": "number"
                  },
                  "MIN_LOADED_LANE": {
                    "description": "Minimum number of loaded lanes.",
                    "type": "integer"
                  },
                  "MAX_LOADED_LANE": {
                    "description": "Maximum number of loaded lanes.",
                    "type": "integer"
                  },
                  "LANE_NAMES": {
                    "description": "Selected lane names; each must reference an existing (surface or line) lane.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "VEHICLE_TYPE",
                  "VEHICLE_NAME",
                  "SCALE_FACTOR",
                  "MIN_LOADED_LANE",
                  "MAX_LOADED_LANE",
                  "LANE_NAMES"
                ]
              }
            },
            "LOAD_MODEL": {
              "description": "Load model index (used under the Australia code).",
              "type": "integer"
            },
            "LOAD_COMB_TYPE": {
              "description": "Load combination type (used under the Australia / Russia codes).",
              "type": "integer"
            },
            "FATIGUE": {
              "description": "Fatigue option.",
              "type": "boolean"
            },
            "_2_LANE_FACTOR_1": {
              "description": "[Korea code, LANE_FACTOR_TYPE=0] Multi-lane factor - 2 lanes - lane 1.",
              "type": "number"
            },
            "_2_LANE_FACTOR_2": {
              "description": "[Korea code, LANE_FACTOR_TYPE=0] Multi-lane factor - 2 lanes - lane 2.",
              "type": "number"
            },
            "_3_LANE_FACTOR_1": {
              "description": "[Korea code, LANE_FACTOR_TYPE=0] Multi-lane factor - 3+ lanes - lane 1.",
              "type": "number"
            },
            "_3_LANE_FACTOR_2": {
              "description": "[Korea code, LANE_FACTOR_TYPE=0] Multi-lane factor - 3+ lanes - lane 2.",
              "type": "number"
            },
            "_3_LANE_FACTOR_3": {
              "description": "[Korea code, LANE_FACTOR_TYPE=0] Multi-lane factor - 3+ lanes - lane 3.",
              "type": "number"
            },
            "_3_LANE_FACTOR_4": {
              "description": "[Korea code, LANE_FACTOR_TYPE=0] Multi-lane factor - 3+ lanes - lane 4.",
              "type": "number"
            }
          }
        }
      },
      "required": ["LCNAME", "TYPE"]
    }
  },
  "example": {
    "Assign": {
      "1": {
        "LCNAME": "MV_Default",
        "DESC": "General moving load case",
        "TYPE": 0,
        "DEFAULT": {
          "LANE_FACTOR_TYPE": 1,
          "SCALE_FACTORS": [1, 0.9, 0.8, 0.7, 0.65, 0.65],
          "COMB_OPTION": "COMBINED",
          "SUB_LOAD_DATAS": [
            {
              "VEHICLE_TYPE": "VL",
              "VEHICLE_NAME": "ST_KL-510FTG",
              "SCALE_FACTOR": 1,
              "MIN_LOADED_LANE": 1,
              "MAX_LOADED_LANE": 2,
              "LANE_NAMES": ["LL_01", "LL_02"]
            }
          ]
        }
      },
      "2": {
        "LCNAME": "MV_Permit",
        "DESC": "Permit vehicle load case",
        "TYPE": 1,
        "PERMIT_LOAD": {
          "VEHICLE_LOAD_NAME": "PV_Permit",
          "REF_LANE": "LL_01",
          "SCALE_FACTOR": 1
        }
      },
      "3": {
        "LCNAME": "MV_AutoOptimize",
        "DESC": "Moving load optimization case",
        "TYPE": 2,
        "AUTO_OPTIMIZE": {
          "LANE_NAME": "LL_01",
          "SCALE_FACTORS": [1, 0.9, 0.8, 0.7, 0.65, 0.65],
          "MIN_VEHL_DIST": 15,
          "MIN_NUM_VEHICLE": 1,
          "MAX_NUM_VEHICLE": 3,
          "FATIGUE": false,
          "LOAD_MODEL": 0,
          "OPTIMIZE_ITEMS": [
            {
              "VEHICLE_TYPE": "VL",
              "VEHICLE_NAME": "ST_KL-510FTG",
              "SCALE_FACTOR": 1
            }
          ]
        }
      },
      "4": {
        "LCNAME": "MV_Australia_HLP",
        "DESC": "Australia Heavy Load Platform with assigned lines",
        "TYPE": 0,
        "DEFAULT": {
          "SCALE_FACTORS": [1, 0.9, 0.8, 0.7, 0.65, 0.65],
          "COMB_OPTION": "COMBINED",
          "LOAD_MODEL": 2
        },
        "ASL": {
          "MULTIPLE_FACTOR": 0.5,
          "VEHICLE_LOAD_NAME": "HLP400",
          "VEHICLE_LOAD_NAME2": "M1600",
          "MIN_LOADED_LANE": 1,
          "MAX_LOADED_LANE": 2,
          "LINE_ITEMS": {
            "NA_LLAN_NAMES": ["LL_01", "LL_02"],
            "STRAD_LLAN1_NAMES": ["LL_01"],
            "STRAD_LLAN2_NAMES": ["LL_02"]
          }
        }
      }
    }
  },
  "manual_title": "Moving Load Cases",
  "feature_name": "Moving Load Cases",
  "manual_url": "https://support.midasuser.com/hc/en-us/articles/35959068573209-Moving-Load-Cases"
}
