{
  "_group": "db",
  "_name": "NODE",
  "uri": "db/NODE",
  "methods": "POST, GET, PUT, DELETE",
  "schema": {
    "NODE": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Node (NODE). A single structural node located by its global Cartesian coordinates X, Y, Z; the id key is the node number.",
      "type": "object",
      "properties": {
        "X": {
          "description": "Global X-position of the node (model length units).",
          "type": "number",
          "default": 0.0
        },
        "Y": {
          "description": "Global Y-position of the node (model length units).",
          "type": "number",
          "default": 0.0
        },
        "Z": {
          "description": "Global Z-position of the node (model length units).",
          "type": "number",
          "default": 0.0
        }
      }
    }
  },
  "example": {
    "Assign": {
      "1": {
        "X": 0.0,
        "Y": 0.0,
        "Z": 0.0
      },
      "2": {
        "X": 5.0,
        "Y": 0.0,
        "Z": 0.0
      },
      "3": {
        "X": 5.0,
        "Y": 3.0,
        "Z": 0.0
      }
    }
  },
  "manual_title": "Node",
  "feature_name": "Create Nodes",
  "manual_url": "https://support.midasuser.com/hc/en-us/articles/35806845654169-Node"
}
